# odoo-agent — plantilla de configuración local
#
# Copiar a .env y rellenar con valores reales:
#     cp .env.example .env
#
# .env está en .gitignore — NUNCA lo commitees.

# ────────────────────────────────────────────────────────────────────────────
# Tenant activo
# ────────────────────────────────────────────────────────────────────────────
# Slug del subdirectorio en docs/tenants/. El agente lee
# docs/tenants/$ODOO_AGENT_TENANT/profile.yaml al inicio de cada sesión.
ODOO_AGENT_TENANT=inpr3mium

# ────────────────────────────────────────────────────────────────────────────
# Conexión RPC a Odoo (las 3 skills la consumen)
# ────────────────────────────────────────────────────────────────────────────
ODOO_URL=https://erp.example.com
ODOO_DB=miempresa_prod
ODOO_USER=bot.contable@example.com
ODOO_API_KEY=

# Opcional: forzar XML-RPC en lugar de JSON-2 (fallback si la instancia
# no expone el endpoint moderno).
# ODOO_FORCE_XMLRPC=1

# ────────────────────────────────────────────────────────────────────────────
# Acceso al host doodba — solo necesario para `odoo-module-admin`
# ────────────────────────────────────────────────────────────────────────────
# Sin estas variables la skill `odoo-module-admin` solo puede hacer
# auditoría RPC (no install/upgrade ni reinicios). Si solo vas a usar
# `odoo-accounting-es` y `odoo-functional-admin`, déjalas vacías.

DOODBA_SSH_HOST=user@erp.example.com
DOODBA_PROJECT_DIR=/opt/doodba/inpr3mium
DOODBA_COMPOSE_SERVICE=odoo
DOODBA_DB_NAME=miempresa_prod

# ────────────────────────────────────────────────────────────────────────────
# Migraciones de versión con OpenUpgrade — solo si vas a migrar
# ────────────────────────────────────────────────────────────────────────────
# Path local en el host doodba donde está clonado OpenUpgrade.
# Solo lo usa `odoo-module-admin/scripts/openupgrade_run.py`.
# OPENUPGRADE_PATH=/opt/openupgrade
