# Estado deseado del despliegue (config-as-code) — plantilla generica.
# Copiar a un archivo del tenant (p.ej. docs/tenants/<slug>/desired_state.yaml)
# y rellenar con valores reales antes de comparar.
#
# Compara con el estado real:
#     python3 scripts/audit_admin_state.py --diff <ruta>/desired_state.yaml
# Reporta missing / extra / changed por seccion. NO aplica cambios.
#
# Cada seccion es opcional: lo que no aparezca aqui no se compara.
# Las claves naturales son:
#   companies: vat
#   users:     login (en minusculas)
#   journals:  (company_vat, code)

companies:
  - vat: ESB99999999
    name: "Acme Holdings S.L."
    currency: EUR
    country: ES
    parent_vat: null

  - vat: ESB88888888
    name: "Acme Iberia S.L."
    currency: EUR
    country: ES
    parent_vat: ESB99999999

  - vat: ESB77777777
    name: "Acme Foods S.L."
    currency: EUR
    country: ES
    parent_vat: ESB99999999

users:
  - login: bot.contable@example.tld
    name: "Bot Contable"
    lang: es_ES
    active: true
    groups:
      - base.group_user
      - base.group_multi_company
      - account.group_account_manager
    company_vats:
      - ESB99999999
      - ESB88888888
      - ESB77777777

  - login: bot.functional@example.tld
    name: "Bot Functional Admin"
    lang: en_US
    active: true
    groups:
      - base.group_user
      - base.group_multi_company
      - base.group_erp_manager
    company_vats:
      - ESB99999999

journals:
  # Acme Iberia - diarios estandar
  - company_vat: ESB88888888
    code: VENT
    type: sale
    name: "Customer Invoices"

  - company_vat: ESB88888888
    code: COMP
    type: purchase
    name: "Vendor Bills"

  - company_vat: ESB88888888
    code: BANC
    type: bank
    name: "Banco Principal"

  # Acme Foods - diarios estandar
  - company_vat: ESB77777777
    code: VENT
    type: sale
    name: "Customer Invoices"

  - company_vat: ESB77777777
    code: COMP
    type: purchase
    name: "Vendor Bills"
